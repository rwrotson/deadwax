# DEADWAX_YOUTUBE__HTML_TRANSPORTS=             # JSON array; HTML requests only, in preferred order
# DEADWAX_YOUTUBE__API_KEY=                    # Data API key; needed for every lookup
# DEADWAX_SOUNDCLOUD__ENABLED=true
# DEADWAX_SOUNDCLOUD__RATE=1
# DEADWAX_SOUNDCLOUD__TTL=604800
# DEADWAX_SOUNDCLOUD__USER_AGENT=              # default: deadwax/<version> (+contact)
# DEADWAX_SOUNDCLOUD__PROXY=                   # default: http.proxy
