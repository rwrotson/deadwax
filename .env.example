# Every DEADWAX_* value is optional; defaults live in deadwax.cli.settings.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.
# Only the deadwax command reads them; the library itself never reads the environment.
# Precedence: command-line flags > environment > .env > TOML config file > defaults.

# Application
# DEADWAX_CONFIG_FILE=./deadwax.toml           # environment or --config only; default: config.toml in the user config directory
# DEADWAX_ADAPTER_TIMEOUT=30                   # seconds per source lookup (--timeout)
# DEADWAX_DEFAULT_SOURCES=core,listenbrainz,secondhandsongs,kexp  # source and group names run without --sources, comma-separated
# DEADWAX_CONCURRENCY=8                        # sources queried at once in a lookup

# Logging
# DEADWAX_LOG__LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEADWAX_LOG__CONSOLE_LEVEL=DEBUG
# DEADWAX_LOG__FILE_LEVEL=INFO
# DEADWAX_LOG__FORMAT=console                  # console or json; file logs are always JSON
# DEADWAX_LOG__DIR=./logs                      # file logging is disabled if unset
# DEADWAX_LOG__FILE_NAME=deadwax.log           # basename only; no directory separators
# DEADWAX_LOG__FILE_MAX_BYTES=4194304
# DEADWAX_LOG__FILE_BACKUP_COUNT=5

# Run journal: one JSON Lines file of trace events per run and an index (deadwax runs)
# DEADWAX_RUNS__ENABLED=true                   # journal every lookup and sources call
# DEADWAX_RUNS__DIR=./logs                     # default: the user log directory
# DEADWAX_RUNS__RETENTION_DAYS=90              # 0 keeps runs forever
# DEADWAX_RUNS__DOSSIER=true                   # store the final dossier in the run's last event

# HTTP
# DEADWAX_HTTP__TIMEOUT=15                     # seconds per request
# DEADWAX_HTTP__CONTACT=https://github.com/rwrotson/deadwax  # sent in the API User-Agent
# DEADWAX_HTTP__RETRIES=3
# DEADWAX_HTTP__RETRY_BASE=1                   # first backoff in seconds; doubles per retry
# DEADWAX_HTTP__MAX_RETRY_WAIT=60
# DEADWAX_HTTP__ESCALATION=browser             # none, impersonate, browser; unset: strongest installed
# DEADWAX_HTTP__MAX_RESPONSE_BYTES=10000000
# DEADWAX_HTTP__PROXY=                         # direct or http(s)://[user:pass@]host:port; unset: HTTPS_PROXY etc.

# Response cache
# DEADWAX_CACHE__ENABLED=true                  # --no-cache disables it for one run
# DEADWAX_CACHE__PATH=./cache.sqlite           # default: responses.sqlite in the user cache directory
# DEADWAX_CACHE__TTL=604800                    # seconds; 7 days
# DEADWAX_CACHE__NOT_FOUND_TTL=86400           # seconds; 1 day
# DEADWAX_CACHE__BLOCKED_TTL=86400             # seconds; 1 day

# Sources: ENABLED, RATE (requests per second; source default when unset), TTL (seconds), USER_AGENT
# DEADWAX_MUSICBRAINZ__ENABLED=true
# DEADWAX_MUSICBRAINZ__RATE=1
# DEADWAX_MUSICBRAINZ__TTL=604800
# DEADWAX_MUSICBRAINZ__USER_AGENT=             # default: deadwax/<version> (+contact)
# DEADWAX_MUSICBRAINZ__PROXY=                  # default: http.proxy
# DEADWAX_ITUNES__ENABLED=true
# DEADWAX_ITUNES__RATE=0.3
# DEADWAX_ITUNES__TTL=604800
# DEADWAX_ITUNES__USER_AGENT=                  # default: deadwax/<version> (+contact)
# DEADWAX_ITUNES__PROXY=                       # default: http.proxy
# DEADWAX_DEEZER__ENABLED=true
# DEADWAX_DEEZER__RATE=2
# DEADWAX_DEEZER__TTL=604800
# DEADWAX_DEEZER__USER_AGENT=                  # default: deadwax/<version> (+contact)
# DEADWAX_DEEZER__PROXY=                       # e.g. direct when Akamai refuses the proxy's address
# DEADWAX_ODESLI__ENABLED=true
# DEADWAX_ODESLI__RATE=0.5
# DEADWAX_ODESLI__TTL=604800
# DEADWAX_ODESLI__USER_AGENT=                  # default: a desktop Chrome User-Agent
# DEADWAX_ODESLI__PROXY=                       # default: http.proxy
# DEADWAX_DISCOGS__ENABLED=true
# DEADWAX_DISCOGS__RATE=1
# DEADWAX_DISCOGS__TTL=604800
# DEADWAX_DISCOGS__USER_AGENT=                 # default python-httpx/<version>: Discogs refuses deadwax's
# DEADWAX_DISCOGS__PROXY=                      # e.g. direct when Cloudflare refuses the proxy's address
# DEADWAX_DISCOGS__TOKEN=                      # personal access token; needed for search
# DEADWAX_BANDCAMP__ENABLED=true
# DEADWAX_BANDCAMP__RATE=0.5
# DEADWAX_BANDCAMP__TTL=604800
# DEADWAX_BANDCAMP__USER_AGENT=                # default: a desktop Chrome User-Agent
# DEADWAX_BANDCAMP__PROXY=                     # default: http.proxy
# DEADWAX_LASTFM__ENABLED=true
# DEADWAX_LASTFM__RATE=4
# DEADWAX_LASTFM__TTL=604800
# DEADWAX_LASTFM__USER_AGENT=                  # default: deadwax/<version> (+contact)
# DEADWAX_LASTFM__PROXY=                       # default: http.proxy
# DEADWAX_LASTFM__API_KEY=                     # required for every Last.fm lookup
# DEADWAX_WIKIPEDIA__ENABLED=true
# DEADWAX_WIKIPEDIA__RATE=5
# DEADWAX_WIKIPEDIA__TTL=604800
# DEADWAX_WIKIPEDIA__USER_AGENT=               # default: deadwax/<version> (+contact)
# DEADWAX_WIKIPEDIA__PROXY=                    # default: http.proxy
# DEADWAX_LISTENBRAINZ__ENABLED=true
# DEADWAX_LISTENBRAINZ__RATE=2
# DEADWAX_LISTENBRAINZ__TTL=604800
# DEADWAX_LISTENBRAINZ__USER_AGENT=            # default: deadwax/<version> (+contact)
# DEADWAX_LISTENBRAINZ__PROXY=                 # default: http.proxy
# DEADWAX_SECONDHANDSONGS__ENABLED=true
# DEADWAX_SECONDHANDSONGS__RATE=0.25
# DEADWAX_SECONDHANDSONGS__TTL=604800
# DEADWAX_SECONDHANDSONGS__USER_AGENT=         # default: deadwax/<version> (+contact)
# DEADWAX_SECONDHANDSONGS__PROXY=              # default: http.proxy
# DEADWAX_SECONDHANDSONGS__API_KEY=            # optional; raises the request limit
# DEADWAX_KEXP__ENABLED=true
# DEADWAX_KEXP__RATE=2
# DEADWAX_KEXP__TTL=604800
# DEADWAX_KEXP__USER_AGENT=                    # default: deadwax/<version> (+contact)
# DEADWAX_KEXP__PROXY=                         # default: http.proxy
