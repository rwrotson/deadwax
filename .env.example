# Every DEADWAX_* value is optional; defaults live in deadwax.cli.settings.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.
# Only the deadwax command reads them; the library itself never reads the environment.
# Precedence: command-line flags > environment > .env > TOML config file > defaults.

# Application
# DEADWAX_CONFIG_FILE=./deadwax.toml           # environment or --config only; default: config.toml in the user config directory
# DEADWAX_ADAPTER_TIMEOUT=30                   # seconds per source lookup (--timeout)
# DEADWAX_DEFAULT_SOURCES=musicbrainz,itunes,odesli,bandcamp,wikipedia,lastfm,discogs,listenbrainz,secondhandsongs,kexp,spotify,youtube,genius  # source and group names run without --sources, comma-separated
# DEADWAX_CONCURRENCY=8                        # sources queried at once in a lookup

# Logging
# DEADWAX_LOG__LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEADWAX_LOG__CONSOLE_LEVEL=DEBUG
# DEADWAX_LOG__FILE_LEVEL=INFO
# DEADWAX_LOG__FORMAT=console                  # console or json; file logs are always JSON
# DEADWAX_LOG__DIR=./logs                      # file logging is disabled if unset
# DEADWAX_LOG__FILE_NAME=deadwax.log           # basename only; no directory separators
# DEADWAX_LOG__FILE_MAX_BYTES=4194304
# DEADWAX_LOG__FILE_BACKUP_COUNT=5

# Run journal: one JSON Lines file of trace events per run and an index (deadwax runs)
# DEADWAX_RUNS__ENABLED=true                   # journal every lookup and sources call
# DEADWAX_RUNS__DIR=./logs                     # default: the user log directory
# DEADWAX_RUNS__RETENTION_DAYS=90              # 0 keeps runs forever
# DEADWAX_RUNS__DOSSIER=true                   # store the final dossier in the run's last event

# HTTP
# DEADWAX_HTTP__TIMEOUT=15                     # seconds per request
# DEADWAX_HTTP__CONTACT=https://github.com/rwrotson/deadwax  # sent in the API User-Agent
# DEADWAX_HTTP__RETRIES=3
# DEADWAX_HTTP__RETRY_BASE=1                   # first backoff in seconds; doubles per retry
# DEADWAX_HTTP__MAX_RETRY_WAIT=60
# DEADWAX_HTTP__ESCALATION='["impersonate","browser","nodriver"]'  # globally allowed optional HTML transports
# DEADWAX_HTTP__BROWSER_HEADLESS=true          # false opens a visible Patchright or Nodriver window
# Lookup flags --headless/--headed and --html-transport override browser settings for one run.
# DEADWAX_HTTP__PATCHRIGHT_CHANNEL=chromium     # chrome uses installed Chrome and a temporary profile
# DEADWAX_HTTP__PATCHRIGHT_PROFILE_DIR=         # dedicated persistent profile; never use your regular Chrome profile
# DEADWAX_HTTP__BROWSER_CHALLENGE_WAIT=5        # seconds to wait for a challenge or required page state
# DEADWAX_HTTP__HEADED_FALLBACK=true           # retry a challenged headless browser page in a window
# DEADWAX_HTTP__HEADED_CHALLENGE_WAIT=60       # seconds a visible browser waits for a challenge solved by hand
# DEADWAX_HTTP__NODRIVER_BROWSER_PATH=          # optional Chrome executable for Nodriver
# DEADWAX_HTTP__NODRIVER_PROFILE_DIR=           # dedicated persistent profile, separate from Patchright
# DEADWAX_HTTP__NODRIVER_SANDBOX=true           # false only for a trusted Chrome executable
# DEADWAX_HTTP__MAX_RESPONSE_BYTES=10000000
# DEADWAX_HTTP__PROXY=                         # direct or http(s)://[user:pass@]host:port; unset: HTTPS_PROXY etc.

# Response cache
# DEADWAX_CACHE__ENABLED=true                  # --no-cache disables it for one run
# DEADWAX_CACHE__PATH=./cache.sqlite           # default: responses.sqlite in the user cache directory
# DEADWAX_CACHE__TTL=604800                    # seconds; 7 days
# DEADWAX_CACHE__NOT_FOUND_TTL=86400           # seconds; 1 day
# DEADWAX_CACHE__BLOCKED_TTL=86400             # seconds; 1 day

# Sources (TOML: [sources.<name>]): ENABLED, RATE (requests per second), TTL (seconds), USER_AGENT
# DEADWAX_SOURCES__MUSICBRAINZ__ENABLED=true
# DEADWAX_SOURCES__MUSICBRAINZ__RATE=1
# DEADWAX_SOURCES__MUSICBRAINZ__TTL=604800
# DEADWAX_SOURCES__MUSICBRAINZ__USER_AGENT=             # default: deadwax/<version> (+contact)
# DEADWAX_SOURCES__MUSICBRAINZ__PROXY=                  # default: http.proxy
# DEADWAX_SOURCES__MUSICBRAINZ__HTML_TRANSPORTS=             # JSON array; HTML requests only, in preferred order
# DEADWAX_SOURCES__MUSICBRAINZ__BROWSER_HEADLESS=           # optional per-source browser mode
# DEADWAX_SOURCES__ITUNES__ENABLED=true
# DEADWAX_SOURCES__ITUNES__RATE=0.3
# DEADWAX_SOURCES__ITUNES__TTL=604800
# DEADWAX_SOURCES__ITUNES__USER_AGENT=                  # default: deadwax/<version> (+contact)
# DEADWAX_SOURCES__ITUNES__PROXY=                       # default: http.proxy
# DEADWAX_SOURCES__ITUNES__HTML_TRANSPORTS=             # JSON array; HTML requests only, in preferred order
# DEADWAX_SOURCES__ITUNES__BROWSER_HEADLESS=           # optional per-source browser mode
# DEADWAX_SOURCES__DEEZER__ENABLED=true
# DEADWAX_SOURCES__DEEZER__RATE=2
# DEADWAX_SOURCES__DEEZER__TTL=604800
# DEADWAX_SOURCES__DEEZER__USER_AGENT=                  # default: deadwax/<version> (+contact)
# DEADWAX_SOURCES__DEEZER__PROXY=                       # e.g. direct when Akamai refuses the proxy's address
# DEADWAX_SOURCES__DEEZER__HTML_TRANSPORTS=             # JSON array; HTML requests only, in preferred order
# DEADWAX_SOURCES__DEEZER__BROWSER_HEADLESS=           # optional per-source browser mode
# DEADWAX_SOURCES__ODESLI__ENABLED=true
# DEADWAX_SOURCES__ODESLI__RATE=0.5
# DEADWAX_SOURCES__ODESLI__TTL=604800
# DEADWAX_SOURCES__ODESLI__USER_AGENT=                  # default: a desktop Chrome User-Agent
# DEADWAX_SOURCES__ODESLI__PROXY=                       # default: http.proxy
# DEADWAX_SOURCES__ODESLI__HTML_TRANSPORTS=             # JSON array; HTML requests only, in preferred order
# DEADWAX_SOURCES__ODESLI__BROWSER_HEADLESS=           # optional per-source browser mode
# DEADWAX_SOURCES__DISCOGS__ENABLED=true
# DEADWAX_SOURCES__DISCOGS__RATE=1
# DEADWAX_SOURCES__DISCOGS__TTL=604800
# DEADWAX_SOURCES__DISCOGS__USER_AGENT=                 # default python-httpx/<version>: Discogs refuses deadwax's
# DEADWAX_SOURCES__DISCOGS__PROXY=                      # e.g. direct when Cloudflare refuses the proxy's address
# DEADWAX_SOURCES__DISCOGS__HTML_TRANSPORTS=             # JSON array; HTML requests only, in preferred order
# DEADWAX_SOURCES__DISCOGS__BROWSER_HEADLESS=           # optional per-source browser mode
